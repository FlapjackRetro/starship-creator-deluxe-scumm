+// ---------------------------------------------------------------------------
+// Bit reader
+// ---------------------------------------------------------------------------
+
+namespace {
+
+struct Reader {
+	const byte *data;
+	uint32 size;
+	uint32 pos;
+	uint32 bitPos;	// 0 = byte aligned
+	bool eof;
+
+	Reader(const byte *d, uint32 s) : data(d), size(s), pos(0), bitPos(0), eof(false) {}
+
+	void align() {
+		if (bitPos) {
+			bitPos = 0;
+			pos++;
+		}
+	}
+	byte u8() {
+		align();
+		if (pos >= size) {
+			eof = true;
+			return 0;
+		}
+		return data[pos++];
+	}
+	uint16 u16() {
+		uint16 lo = u8();
+		uint16 hi = u8();
+		return lo | (hi << 8);
+	}
+	int16 s16() { return (int16)u16(); }
+	uint32 u32() {
+		uint32 lo = u16();
+		uint32 hi = u16();
+		return lo | (hi << 16);
+	}
+	uint32 ub(int n) {
+		uint32 v = 0;
+		for (int i = 0; i < n; i++) {
+			if (pos >= size) {
+				eof = true;
+				return v << (n - i);
+			}
+			int bit = (data[pos] >> (7 - bitPos)) & 1;
+			v = (v << 1) | bit;
+			if (++bitPos == 8) {
+				bitPos = 0;
+				pos++;
+			}
+		}
+		return v;
+	}
+	int32 sb(int n) {
+		if (n == 0)
+			return 0;
+		uint32 v = ub(n);
+		if (v & (1u << (n - 1)))
+			return (int32)(v | ~((1u << n) - 1));
+		return (int32)v;
+	}
+	float fb(int n) { return sb(n) / 65536.0f; }
+	bool atEnd() const { return eof || pos >= size; }
+};
+
+SWFMovie::Matrix readMatrix(Reader &r) {
+	SWFMovie::Matrix m;
+	r.align();
+	if (r.ub(1)) {
+		int n = r.ub(5);
+		m.a = r.fb(n);
+		m.d = r.fb(n);
+	}
+	if (r.ub(1)) {
+		int n = r.ub(5);
+		m.b = r.fb(n);
+		m.c = r.fb(n);
+	}
+	int n = r.ub(5);
+	m.tx = (float)r.sb(n);
+	m.ty = (float)r.sb(n);
+	r.align();
+	return m;
+}
+
+void readRect(Reader &r, int &xmin, int &xmax, int &ymin, int &ymax) {
+	r.align();
+	int n = r.ub(5);
+	xmin = r.sb(n);
+	xmax = r.sb(n);
+	ymin = r.sb(n);
+	ymax = r.sb(n);
+	r.align();
+}
+
+SWFMovie::ColorXform readCxform(Reader &r) {
+	SWFMovie::ColorXform c;
+	r.align();
+	bool hasAdd = r.ub(1);
+	bool hasMult = r.ub(1);
+	int n = r.ub(4);
+	if (hasMult) {
+		c.mr = r.sb(n) / 256.0f;
+		c.mg = r.sb(n) / 256.0f;
+		c.mb = r.sb(n) / 256.0f;
+	}
+	if (hasAdd) {
+		c.ar = (float)r.sb(n);
+		c.ag = (float)r.sb(n);
+		c.ab = (float)r.sb(n);
+	}
+	r.align();
+	return c;
+}
+
+void readFillStyles(Reader &r, Common::Array<SWFMovie::FillStyle> &fills, bool shape2) {
+	int count = r.u8();
+	if (count == 0xFF && shape2)
+		count = r.u16();
+	for (int i = 0; i < count && !r.atEnd(); i++) {
+		SWFMovie::FillStyle fs;
+		int type = r.u8();
+		if (type == 0x00) {
+			fs.type = 0;
+			fs.r = r.u8();
+			fs.g = r.u8();
+			fs.b = r.u8();
+		} else if (type == 0x10 || type == 0x12) {
+			fs.type = (type == 0x10) ? 1 : 2;
+			fs.matrix = readMatrix(r);
+			int n = r.u8();
+			for (int j = 0; j < n; j++) {
+				fs.ratios.push_back(r.u8());
+				fs.colors.push_back(r.u8());
+				fs.colors.push_back(r.u8());
+				fs.colors.push_back(r.u8());
+			}
+		} else if (type >= 0x40 && type <= 0x43) {
+			fs.type = 3;
+			r.u16();	// bitmap id
+			fs.matrix = readMatrix(r);
+			fs.r = fs.g = fs.b = 128;
+		} else {
+			r.eof = true;
+		}
+		fills.push_back(fs);
+	}
+}
+
+void readLineStyles(Reader &r, Common::Array<SWFMovie::LineStyle> &lines, bool shape2) {
+	int count = r.u8();
+	if (count == 0xFF && shape2)
+		count = r.u16();
+	for (int i = 0; i < count && !r.atEnd(); i++) {
+		SWFMovie::LineStyle ls;
+		ls.width = r.u16();
+		ls.r = r.u8();
+		ls.g = r.u8();
+		ls.b = r.u8();
+		lines.push_back(ls);
+	}
+}
+
+// Reads shape records (after the style arrays when withStyles is true).
+void readShapeRecords(Reader &r, SWFMovie::Shape &shape, bool withStyles, bool shape2, int implicitFill) {
+	int fillBits = r.ub(4);
+	int lineBits = r.ub(4);
+	float x = 0, y = 0;
+	int fill0 = implicitFill, fill1 = implicitFill, line = 0;
+	int fillBase = 0, lineBase = 0;
+	(void)withStyles;
+
+	while (!r.atEnd()) {
+		if (r.ub(1) == 0) {
+			int flags = r.ub(5);
+			if (flags == 0)
+				break;
+			bool newStyles = flags & 16;
+			bool lineStyle = flags & 8;
+			bool fillStyle1 = flags & 4;
+			bool fillStyle0 = flags & 2;
+			bool moveTo = flags & 1;
+			if (moveTo) {
+				int n = r.ub(5);
+				x = (float)r.sb(n);
+				y = (float)r.sb(n);
+			}
+			if (fillStyle0) {
+				int v = r.ub(fillBits);
+				fill0 = v ? v + fillBase : 0;
+			}
+			if (fillStyle1) {
+				int v = r.ub(fillBits);
+				fill1 = v ? v + fillBase : 0;
+			}
+			if (lineStyle) {
+				int v = r.ub(lineBits);
+				line = v ? v + lineBase : 0;
+			}
+			if (newStyles && shape2) {
+				fillBase = shape.fills.size();
+				lineBase = shape.lines.size();
+				readFillStyles(r, shape.fills, true);
+				readLineStyles(r, shape.lines, true);
+				fillBits = r.ub(4);
+				lineBits = r.ub(4);
+			}
+		} else {
+			SWFMovie::Edge e;
+			e.fill0 = fill0;
+			e.fill1 = fill1;
+			e.line = line;
+			e.x0 = x;
+			e.y0 = y;
+			if (r.ub(1)) {	// straight
+				int n = r.ub(4) + 2;
+				float dx = 0, dy = 0;
+				if (r.ub(1)) {
+					dx = (float)r.sb(n);
+					dy = (float)r.sb(n);
+				} else if (r.ub(1)) {
+					dy = (float)r.sb(n);
+				} else {
+					dx = (float)r.sb(n);
+				}
+				x += dx;
+				y += dy;
+				e.curve = false;
+				e.cx = e.cy = 0;
+			} else {
+				int n = r.ub(4) + 2;
+				float cdx = (float)r.sb(n);
+				float cdy = (float)r.sb(n);
+				float adx = (float)r.sb(n);
+				float ady = (float)r.sb(n);
+				e.cx = x + cdx;
+				e.cy = y + cdy;
+				x = e.cx + adx;
+				y = e.cy + ady;
+				e.curve = true;
+			}
+			e.x1 = x;
+			e.y1 = y;
+			shape.edges.push_back(e);
+		}
+	}
+	r.align();
+}
+
+} // End of anonymous namespace
