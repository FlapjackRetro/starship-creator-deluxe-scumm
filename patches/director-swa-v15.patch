+		cast->setCastMember(id.member, new BitmapCastMember(cast, id.member));
+	CastMember *member = movie->getCastMember(id);
+	if (!member || member->_type != kCastBitmap)
+		return;
+	BitmapCastMember *bitmap = static_cast<BitmapCastMember *>(member);
+
+	delete bitmap->_picture;
+	bitmap->_picture = new Picture();
+	bitmap->_picture->_surface.copyFrom(src->rawSurface().getSubArea(area));
+	if (src->format.bytesPerPixel == 1) {
+		const byte *pal = g_director->_wm->getPalette();
+		bitmap->_picture->copyPalette(pal, g_director->_wm->getPaletteSize());
+	}
+	bitmap->_initialRect = Common::Rect(area.width(), area.height());
+	bitmap->_regX = area.width() / 2;
+	bitmap->_regY = area.height() / 2;
+	bitmap->_external = true;
+	bitmap->setModified(true);
+}
