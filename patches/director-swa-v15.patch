+	Movie *movie = g_director->getCurrentMovie();
+	Window *stage = g_director->getCurrentWindow();
+	if (!movie || !stage)
+		return;
+
+	Graphics::ManagedSurface *src = stage->getSurface();
+	Common::Rect area(left, top, right, bottom);
+	area.clip(Common::Rect(src->w, src->h));
