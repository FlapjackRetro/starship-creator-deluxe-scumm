+// ---------------------------------------------------------------------------
+// Cast member
+// ---------------------------------------------------------------------------
+
+FlashXtraCastMember::FlashXtraCastMember(Cast *cast, uint16 castId, XtraCastMember &source)
+		: CastMember(cast, castId) {
+	_type = kCastXtra;
+	_valid = false;
+	_frame = 0;
+	_viewSet = false;
+	_viewH = _viewV = 0;
+	_viewScale = 100;
+	_originCenter = true;
+	_regX = _regY = 0;
+	_mask = nullptr;
+	const Common::Array<byte> &xd = source.getXtraData();
+	if (xd.size() >= 144) {
+		auto rdf = [&](int idx) {
+			uint32 v = (xd[idx * 4] << 24) | (xd[idx * 4 + 1] << 16) | (xd[idx * 4 + 2] << 8) | xd[idx * 4 + 3];
+			float f;
+			memcpy(&f, &v, 4);
+			return f;
+		};
+		auto rdi = [&](int idx) {
+			return (int)((xd[idx * 4] << 24) | (xd[idx * 4 + 1] << 16) | (xd[idx * 4 + 2] << 8) | xd[idx * 4 + 3]);
+		};
+		(void)rdf;
+		if (rdi(8) == 1 && rdi(13) > 0 && rdi(14) > 0) {
+			// registration at the center of the member (160,120 is just Flash's placeholder)
+			_regX = rdi(14) / 2.0f;
+			_regY = rdi(13) / 2.0f;
+		} else {
+			_regY = (float)rdi(9);
+			_regX = (float)rdi(10);
+		}
+		_viewH = _regX;
+		_viewV = _regY;
+	}
+}
+
+FlashXtraCastMember::FlashXtraCastMember(Cast *cast, uint16 castId, FlashXtraCastMember &source)
+		: CastMember(cast, castId) {
+	_type = kCastXtra;
+	_initialRect = source._initialRect;
+	_boundingRect = source._boundingRect;
+	_movie = source._movie;
+	_valid = source._valid;
+	_frame = source._frame;
+	_viewSet = source._viewSet;
+	_viewH = source._viewH;
+	_viewV = source._viewV;
+	_viewScale = source._viewScale;
+	_originCenter = source._originCenter;
+	_mask = nullptr;
+	_regX = source._regX;
+	_regY = source._regY;
+	_loaded = source._loaded;
+	if (cast == source._cast)
+		_children = source._children;
+}
+
+FlashXtraCastMember::~FlashXtraCastMember() {
+	delete _mask;
+}
+
+void FlashXtraCastMember::load() {
+	if (_loaded)
+		return;
+	_loaded = true;
+
+	for (auto &it : _children) {
+		if (it.tag != MKTAG('X', 'M', 'E', 'D'))
+			continue;
+		if (!_cast->getArchive()->hasResource(it.tag, it.index)) {
+			warning("FlashXtraCastMember::load(): XMED %d not found", it.index);
+			break;
+		}
+		Common::SeekableReadStreamEndian *r = _cast->getArchive()->getResource(it.tag, it.index);
+		Common::Array<byte> data(r->size());
+		r->read(data.data(), r->size());
+		delete r;
+
+		// find the SWF signature inside the chunk
+		for (uint i = 0; i + 12 < data.size(); i++) {
+			if (data[i] == 'F' && data[i + 1] == 'W' && data[i + 2] == 'S') {
+				_valid = _movie.load(&data[i], data.size() - i);
+				break;
+			}
+		}
+		if (_valid) {
+			Common::Rect stage = _movie.getStageRect();
+			if (_initialRect.isEmpty())
+				_initialRect = stage;
+			debugC(3, kDebugImages, "FlashXtraCastMember::load(): cast %d: %dx%d, %d frames", _castId, stage.width(), stage.height(), _movie.getFrameCount());
+		} else {
+			warning("FlashXtraCastMember::load(): cast %d: could not decode SWF", _castId);
+		}
+		break;
+	}
+}
+
+Graphics::MacWidget *FlashXtraCastMember::createWidget(Common::Rect &bbox, Channel *channel, SpriteType spriteType) {
+	if (!bbox.width() || !bbox.height())
+		return nullptr;
+
+	load();
+
+	Graphics::MacWidget *widget = new Graphics::MacWidget(g_director->getCurrentWindow()->getMacWindow(),
+			bbox.left, bbox.top, bbox.width(), bbox.height(), g_director->_wm, false);
+	Graphics::ManagedSurface *surf = widget->getSurface();
+
+	if (!_valid) {
+		surf->fillRect(Common::Rect(surf->w, surf->h), g_director->_wm->_colorWhite);
+		return widget;
+	}
+
+	debugC(3, kDebugImages, "flash cast %d init %dx%d stage %dx%d reg %g,%g bbox %d,%d %dx%d ch=%d", _castId, _initialRect.width(), _initialRect.height(), stageW(), stageH(), _regX,_regY, bbox.left, bbox.top, bbox.width(), bbox.height(), channel && channel->_sprite ? (int)channel->_sprite->_castId.member : -1);
+	Common::Array<byte> rgba;
+	// Flash sprites default to scaleMode #showAll: content keeps its aspect
+	// ratio and is centered in the sprite rect.
+	float iw = (float)MAX((int16)1, stageW());
+	float ih = (float)MAX((int16)1, stageH());
+	float r = MIN(bbox.width() / iw, bbox.height() / ih);
+	float ox = (bbox.width() - iw * r) / 2.0f;
+	float oy = (bbox.height() - ih * r) / 2.0f;
+	FlashXtra::SWFMovie::Matrix m;
+	float s = _viewSet ? 100.0f / MAX(_viewScale, 1.0f) : 1.0f;
+	float vh = _viewSet ? _viewH : _regX;
+	float vv = _viewSet ? _viewV : _regY;
+	m.a = s * r / 20.0f;
+	m.d = s * r / 20.0f;
+	m.tx = ox + _regX * r - vh * s * r;
+	m.ty = oy + _regY * r - vv * s * r;
+	debugC(3, kDebugImages, "FlashXtraCastMember: cast %d bbox %dx%d view (%g,%g) scale %g", _castId, bbox.width(), bbox.height(), vh, vv, s);
+	_movie.render(_frame, bbox.width(), bbox.height(), rgba, &m);
+
+	delete _mask;
+	_mask = new Graphics::ManagedSurface(bbox.width(), bbox.height(), Graphics::PixelFormat::createFormatCLUT8());
+	for (int y = 0; y < bbox.height(); y++)
+		for (int x = 0; x < bbox.width(); x++)
+			*((byte *)_mask->getBasePtr(x, y)) = rgba[(y * bbox.width() + x) * 4 + 3] ? 1 : 0;
+
+	const Graphics::PixelFormat &fmt = surf->format;
+	// cache nearest-colour lookups for indexed output
+	Common::HashMap<uint32, uint32> cache;
+	for (int y = 0; y < bbox.height(); y++) {
+		for (int x = 0; x < bbox.width(); x++) {
+			const byte *p = &rgba[(y * bbox.width() + x) * 4];
+			uint32 color;
+			if (fmt.bytesPerPixel == 1) {
+				uint32 key = (p[0] << 16) | (p[1] << 8) | p[2];
+				if (cache.contains(key)) {
+					color = cache.getVal(key);
+				} else {
+					color = g_director->_wm->findBestColor(p[0], p[1], p[2]);
+					cache[key] = color;
+				}
+			} else {
+				color = fmt.RGBToColor(p[0], p[1], p[2]);
+			}
+			if (fmt.bytesPerPixel == 1)
+				*((byte *)surf->getBasePtr(x, y)) = (byte)color;
+			else if (fmt.bytesPerPixel == 2)
+				*((uint16 *)surf->getBasePtr(x, y)) = (uint16)color;
+			else
+				*((uint32 *)surf->getBasePtr(x, y)) = color;
+		}
+	}
+
+	return widget;
+}
+
+bool FlashXtraCastMember::hasField(int field) {
+	switch (field) {
+	case kTheFrame:
+	case kTheViewH:
+	case kTheViewV:
+	case kTheViewScale:
+	case kTheViewPoint:
+	case kTheOriginMode:
+	case kTheStatic:
+	case kTheImageEnabled:
+	case kTheRegPoint:
+		return true;
+	default:
+		break;
+	}
+	return CastMember::hasField(field);
+}
+
+Datum FlashXtraCastMember::getField(int field) {
+	Datum d;
+
+	switch (field) {
+	case kTheCastType:
+	case kTheType:
+		d = Common::String("flash");
+		d.type = SYMBOL;
+		break;
+	case kTheFrame:
+		d = _frame + 1;
+		break;
+	case kTheViewPoint:
+		d.type = POINT;
+		d.u.farr = new FArray;
+		d.u.farr->arr.push_back(Datum((double)_viewH));
+		d.u.farr->arr.push_back(Datum((double)_viewV));
+		break;
+	case kTheViewH:
+		d = (double)_viewH;
+		break;
+	case kTheViewV:
+		d = (double)_viewV;
+		break;
+	case kTheViewScale:
+		d = (double)_viewScale;
+		break;
+	case kTheOriginMode:
+		d = Common::String(_originCenter ? "center" : "topLeft");
+		d.type = SYMBOL;
+		break;
+	case kTheStatic:
+	case kTheImageEnabled:
+		d = 1;
+		break;
+	case kTheRegPoint:
+		d.type = POINT;
+		d.u.farr = new FArray;
+		d.u.farr->arr.push_back((double)_regX);
+		d.u.farr->arr.push_back((double)_regY);
+		break;
+	default:
+		d = CastMember::getField(field);
+		break;
+	}
+
+	return d;
+}
+
+void FlashXtraCastMember::setField(int field, const Datum &d) {
+	debugC(3, kDebugImages, "FlashXtraCastMember::setField(%d) cast %d = %s", field, _castId, d.asString(true).c_str());
+	switch (field) {
+	case kTheRegPoint:
+		if (d.type == POINT && d.u.farr->arr.size() >= 2) {
+			Score *score = g_director->getCurrentMovie()->getScore();
+			if (score)
+				score->invalidateRectsForMember(this);
+			_regX = (float)d.u.farr->arr[0].asFloat();
+			_regY = (float)d.u.farr->arr[1].asFloat();
+			setModified(true);
+		}
+		return;
+	case kTheFrame:
+		_frame = MAX(0, d.asInt() - 1);
+		setModified(true);
+		return;
+	case kTheViewH:
+		_viewH = d.asFloat();
+		_viewSet = true;
+		setModified(true);
+		return;
+	case kTheViewV:
+		_viewV = d.asFloat();
+		_viewSet = true;
+		setModified(true);
+		return;
+	case kTheViewScale:
+		_viewScale = d.asFloat();
+		_viewSet = true;
+		setModified(true);
+		return;
+	case kTheViewPoint:
+		if (d.type == POINT && d.u.farr->arr.size() >= 2) {
+			_viewH = d.u.farr->arr[0].asFloat();
+			_viewV = d.u.farr->arr[1].asFloat();
+			_viewSet = true;
+			setModified(true);
+		}
+		return;
+	case kTheOriginMode:
+		_originCenter = !d.asString().equalsIgnoreCase("topLeft");
+		setModified(true);
+		return;
+	case kTheStatic:
+	case kTheImageEnabled:
+		return;
+	default:
+		break;
+	}
+
+	CastMember::setField(field, d);
+}
+
+// Convert between stage and Flash movie coordinates for a sprite displaying this member.
+// bbox: the sprite's on-stage rectangle.
+void FlashXtraCastMember::stageToFlash(const Common::Rect &bbox, float sx, float sy, float &fx, float &fy) {
+	float s = 100.0f / MAX(_viewScale, 1.0f);
+	float rx = bbox.width() / (float)MAX((int16)1, _initialRect.width());
+	float ry = bbox.height() / (float)MAX((int16)1, _initialRect.height());
+	float dx = sx - bbox.left, dy = sy - bbox.top;
+	fx = _viewH + (dx / rx - _regX) / s;
+	fy = _viewV + (dy / ry - _regY) / s;
+}
+
+void FlashXtraCastMember::flashToStage(const Common::Rect &bbox, float fx, float fy, float &sx, float &sy) {
+	float s = 100.0f / MAX(_viewScale, 1.0f);
+	float rx = bbox.width() / (float)MAX((int16)1, _initialRect.width());
+	float ry = bbox.height() / (float)MAX((int16)1, _initialRect.height());
+	sx = bbox.left + (_regX + (fx - _viewH) * s) * rx;
+	sy = bbox.top + (_regY + (fy - _viewV) * s) * ry;
+}
+
+Common::String FlashXtraCastMember::formatInfo() {
+	return Common::String::format("initialRect: %dx%d, frames: %d", _initialRect.width(), _initialRect.height(), _movie.getFrameCount());
+}
