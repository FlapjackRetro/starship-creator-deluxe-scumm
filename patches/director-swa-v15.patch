+SWFMovie::Matrix SWFMovie::Matrix::operator*(const Matrix &o) const {
+	Matrix r;
+	r.a = a * o.a + c * o.b;
+	r.b = b * o.a + d * o.b;
+	r.c = a * o.c + c * o.d;
+	r.d = b * o.c + d * o.d;
+	r.tx = a * o.tx + c * o.ty + tx;
+	r.ty = b * o.tx + d * o.ty + ty;
+	return r;
+}
+
+SWFMovie::Matrix SWFMovie::Matrix::inverse() const {
+	Matrix r;
+	float det = a * d - b * c;
+	if (fabsf(det) < 1e-12f)
+		return r;
+	r.a = d / det;
+	r.b = -b / det;
+	r.c = -c / det;
+	r.d = a / det;
+	r.tx = -(r.a * tx + r.c * ty);
+	r.ty = -(r.b * tx + r.d * ty);
+	return r;
+}
