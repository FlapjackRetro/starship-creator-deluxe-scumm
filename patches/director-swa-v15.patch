+// Copies a region of the stage into a bitmap cast member.
+void LB::b_stageToMember(int nargs) {
+	Datum mem = g_lingo->pop();
+	int bottom = g_lingo->pop().asInt();
+	int right = g_lingo->pop().asInt();
+	int top = g_lingo->pop().asInt();
+	int left = g_lingo->pop().asInt();
